{
  // Kick Assembler source: route *.asm to the Kick Assembler language mode (paulhocker.kick-assembler-vscode-ext).
  "files.associations": {
    "*.asm": "kickassembler"
  },
  // 2-space indent; the byte-perfect // [addr:bytes] comments sit at column 38.
  "[kickassembler]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [38, 120],
    "editor.wordWrap": "off"
  },
  // Extension's own assembler (live diagnostics only). The startup file is the refactored build, the one meant for
  // editing. Build and run through the MOTR tasks: they also check byte identity and start VICE correctly.
  "kickassembler.assembler.jar": "/Users/anthonyjclarke/tools/KickAss.jar",
  "kickassembler.java.runtime": "/usr/bin/java",
  "kickassembler.startup": "refactored/src/main.asm",
  "kickassembler.outputDirectory": "build",
  "kickassembler.emulator.runtime": "/opt/homebrew/bin/x64sc",
  // motr.asm is ~1 MB; don't let large-file heuristics disable tokenisation.
  "editor.largeFileOptimizations": false,
  "files.exclude": {
    "**/__pycache__": true
  },
  "search.exclude": {
    "build/**": true,
    "documentation/MONTY_ON_THE_RUN.html": true,
    "tools/vendor/**": true
  }
}
